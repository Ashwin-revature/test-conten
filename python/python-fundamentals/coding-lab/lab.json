    "python/python-fundamentals/testing-with-pytest#o1",
    "python/python-fundamentals/testing-with-pytest#o3"
  ],
  "language": "python",
  "prerequisites": [
    {
      "tool": "python",
      "version": ">=3.12",
      "check": "python --version"
    }
  ],
  "os": [
    "macos",
    "linux",
    "windows"
  ],
  "network": {
    "setup": "once",
    "test": "none"
  },
  "setup": {
    "command": "python -m pip install -r starter/requirements.txt",
    "cwd": "."
  },
  "test": {
    "command": "python -m pytest -q",
    "cwd": ".",
    "timeoutSeconds": 120,
    "starterExpectation": "fail",
    "failingTests": [
      "starter/test_signups.py::test_open_when_plenty_of_seats",
      "tests/test_main.py::test_task01_session_status_and_tables_needed_port_the_java_methods",
      "tests/test_main.py::test_task02_find_signup_returns_none_and_describe_tests_it_with_is_none",
      "tests/test_main.py::test_task03_normalize_signup_has_a_default_session_and_type_hints",
      "tests/test_main.py::test_task04_report_line_takes_any_values_and_keyword_fields",
      "tests/test_main.py::test_task05_counts_use_dict_get_and_items_unpacking",
      "tests/test_main.py::test_task06_comprehensions_and_a_negative_slice",
      "tests/test_main.py::test_task07_aliasing_bugs_are_fixed",
      "tests/test_main.py::test_task08_parse_seats_raises_signuperror_and_logs",
      "tests/test_main.py::test_task09_summary_script_runs_and_imports_safely",
      "tests/test_main.py::test_task10_your_tests_use_fixtures_parametrize_and_raises_and_catch_bugs"
    ]
  },
  "fixtures": {
    "seed": 0,
    "files": []
  },
  "expectedOutput": "expected/on-completion.txt",
  "cleanup": {
    "paths": [
      ".venv",
      ".pytest_cache",
      "starter/__pycache__",
      "starter/signups/__pycache__",
      "tests/__pycache__"
    ],
    "notes": "Setup creates the virtual environment .venv in the lab folder (the README creates and activates it before the setup command) and installs the exact versions pinned in starter/requirements.txt, which is the lab's lock of every installed package. The test command writes .pytest_cache and __pycache__ folders; the Task 9 and Task 10 checks start child Python processes with bytecode writing off and the pytest cache plugin disabled, and those processes write nothing else. The lab uses no database, network or fixture files; the sample records live in starter/signups/sample.py. Resetting the learner's work means copying the three edited files back from a fresh copy of the lab. The expected output replaces the per-learner test count and the run time with placeholders, because Task 10 adds the learner's own tests to the run. The 45-minute median is a task-by-task authoring estimate of the ten tasks, not a measured learner pilot; 60 minutes is the cap of the 30-60 minute module-lab allowance. Tasks are behavior-tested; tasks 1-9 also check the source for the taught construct (elif, while, is None, type hints, *values/**fields, dict.get, items() unpacking, comprehensions, a slice, try/except ValueError/else/finally, the __name__ guard, * and ** unpacking at the call), and Task 10 runs the learner's tests against their code and against three broken versions of session_status and parse_seats."
  },
  "minutes": {
    "estimatedMedian": 45,
    "cap": 60
  },
  "trackRequirement": {
    "standard": "required",
    "fast": "not-required"
  },
  "platform": {
    "handoff": "bundle",
    "adapter": null
  },
  "licensing": []
}
